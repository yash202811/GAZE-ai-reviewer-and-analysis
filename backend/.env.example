# Copy this file to backend/.env and fill in your key.
# Get a key at https://build.nvidia.com (free "NVIDIA Developer" API key, starts with nvapi-).
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: override the model. Ask GET /v1/models (with your key) what is available.
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
